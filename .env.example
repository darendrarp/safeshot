# SafeShot — Firebase configuration
# Copy to `.env` and fill in your Firebase web app config
# (Firebase console > Project settings > Your apps > Web app).
# Without these values the app runs in DEMO MODE (local pattern scan only).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: reCAPTCHA Enterprise site key for App Check in production.
# On localhost the App Check debug provider is used instead (see README).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
